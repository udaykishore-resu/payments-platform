        }
      },
      "documentChecksum": "b4e011224f7a9c3d6e8b0a2f5c7d9e1b3a5c7e9f1d3b5a7c9e1f3d5b7a9c1e30",
      "reason": "Routing weights caused authorization-rate regression, INC-4471",
      "rolledBackBy": "usr_ops_2291",
      "rolledBackAt": "2026-08-27T21:04:00.190Z"
    }
  ]
}
