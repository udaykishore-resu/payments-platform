      "configurationId": "cfg_01JB8ZBBBBBBBBBBBBBBBBBBBB",
      "configurationVersionId": "cfv_01JB8ZDDDDDDDDDDDDDDDDDDDD",
      "version": 8,
      "rolledBackFrom": 7,
