    {
      "id": 10,
      "title": "Health state changes (1h)",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 22
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "changes(pp_circuit_breaker_state{gateway=\"$gateway\"}[1h])",
          "editorMode": "code",
          "range": false,
          "format": "table",
          "legendFormat": "{{operation}}",
          "instant": true
        }
      ],
      "description": "Flapping \u2014 many changes per hour \u2014 is worse than a stable OPEN: it means the half-open probe keeps succeeding once and failing again, and each cycle sends real payments at a gateway that cannot serve them."
    },
