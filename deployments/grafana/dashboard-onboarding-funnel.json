{
  "uid": "pp-onboarding-funnel",
  "title": "Payments \u2014 Onboarding Funnel",
  "description": "Audience: onboarding ops, customer success, product.",
  "tags": [
    "payments",
    "onboarding",
    "funnel"
  ],
  "timezone": "utc",
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "graphTooltip": 1,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m",
      "15m",
      "1h"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "AMP",
          "value": "AMP"
        },
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "env",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(pp_http_requests_total, env)",
        "query": {
          "query": "label_values(pp_http_requests_total, env)",
          "refId": "env"
        },
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "sort": 1,
        "current": {
          "selected": false,
          "text": "prod",
          "value": "prod"
        },
        "options": [],
        "hide": 0
      },
      {
        "name": "region",
        "label": "Region",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(pp_http_requests_total, region)",
        "query": {
          "query": "label_values(pp_http_requests_total, region)",
          "refId": "region"
        },
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "sort": 1,
        "current": {
          "selected": false,
          "text": "eu-west-1",
          "value": "eu-west-1"
        },
        "options": [],
        "hide": 0
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(pp_http_requests_total, service)",
        "query": {
          "query": "label_values(pp_http_requests_total, service)",
          "refId": "service"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "sort": 1,
        "current": {
          "selected": false,
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "hide": 0
      },
      {
        "name": "gateway",
        "label": "Gateway",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(pp_gateway_errors_total, gateway)",
        "query": {
          "query": "label_values(pp_gateway_errors_total, gateway)",
          "refId": "gateway"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "sort": 1,
        "current": {
          "selected": false,
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "hide": 0
      },
      {
        "name": "tenant_tier",
        "label": "Tenant tier",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(pp_http_requests_total, tenant_tier)",
        "query": {
          "query": "label_values(pp_http_requests_total, tenant_tier)",
          "refId": "tenant_tier"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "sort": 1,
        "current": {
          "selected": false,
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "hide": 0
      },
      {
        "name": "interval",
        "label": "Interval",
        "type": "interval",
        "query": "1m,5m,10m,30m,1h",
        "auto": true,
        "auto_count": 30,
        "auto_min": "1m",
        "current": {
          "text": "5m",
          "value": "5m"
        },
        "hide": 0,
        "options": [
          {
            "text": "1m",
            "value": "1m",
            "selected": false
          },
          {
            "text": "5m",
            "value": "5m",
            "selected": true
          },
          {
            "text": "10m",
            "value": "10m",
            "selected": false
          },
          {
            "text": "30m",
            "value": "30m",
            "selected": false
          },
          {
            "text": "1h",
            "value": "1h",
            "selected": false
          }
        ]
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Deploys",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "enable": true,
        "iconColor": "purple",
        "expr": "changes(kube_deployment_status_observed_generation[1m]) > 0",
        "titleFormat": "deploy",
        "textFormat": "{{deployment}}",
        "hide": false,
        "description": "Argo CD sync events overlaid on every panel. Half of 'when did this start' questions are answered by the purple line, and asking them without deploy markers is guessing."
      },
      {
        "name": "Rollout steps",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "enable": true,
        "iconColor": "orange",
        "expr": "changes(rollout_info_replicas_updated[1m]) > 0",
        "titleFormat": "canary step",
        "textFormat": "{{name}}"
      }
    ]
  },
  "links": [
    {
      "title": "Runbooks",
      "type": "link",
      "url": "https://docs.example.com/runbooks",
      "targetBlank": true,
      "icon": "doc"
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "Instances by state",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (state) (pp_workflow_instances{workflow=\"merchant-onboarding@v1\"})",
          "editorMode": "code",
          "range": true,
          "format": null,
          "legendFormat": "{{state}}"
        }
      ],
      "description": "Ordered by the merchant lifecycle. A pile-up at one state is the funnel's current bottleneck."
    },
    {
      "id": 2,
      "title": "Funnel conversion",
      "type": "barchart",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (state) (increase(pp_merchant_state_entered_total[30d]))",
          "editorMode": "code",
          "range": true,
          "format": null,
          "legendFormat": "{{state}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Workflow DLQ depth",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "pp_dlq_depth{queue=\"workflow_dlq\"}",
          "editorMode": "code",
          "range": true,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 4,
      "title": "Blocked on manual compliance gate",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 20
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "pp_workflow_instances{state=\"AWAITING_SIGNAL\",step=\"compliance-review\"}",
          "editorMode": "code",
          "range": true,
          "format": "time_series"
        }
      ],
      "description": "The funnel's real bottleneck in practice. The automated portion has a 30-minute SLO; this gate has a five-day timeout. Showing them on one dashboard is what keeps the 'onboarding is slow' conversation about staffing when it is about staffing."
    },
    {
      "id": 5,
      "title": "Step duration p95 by step",
      "type": "heatmap",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "calculate": false,
        "cellGap": 1,
        "color": {
          "mode": "scheme",
          "scheme": "Spectral",
          "steps": 64
        },
        "yAxis": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le,step) (rate(pp_workflow_step_duration_seconds_bucket{workflow=\"merchant-onboarding@v1\"}[1h])))",
          "editorMode": "code",
          "range": true,
          "format": null,
          "legendFormat": "{{step}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Slowest steps, ranked",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "topk(5, histogram_quantile(0.95, sum by (le,step) (rate(pp_workflow_step_duration_seconds_bucket[6h]))))",
          "editorMode": "code",
          "range": false,
          "format": "table",
          "legendFormat": "{{step}}",
          "instant": true
        }
      ]
    },
    {
      "id": 7,
      "title": "Step failure rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (step) (rate(pp_workflow_step_duration_seconds_count{outcome=\"failed\"}[1h]))",
          "editorMode": "code",
          "range": true,
          "format": null,
          "legendFormat": "{{step}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "End-to-end p50 / p95 vs the 30-min SLO",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1800
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "pp:onboarding_duration:p95_1h",
          "editorMode": "code",
          "range": true,
          "format": null,
          "legendFormat": "p95"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(pp_onboarding_duration_seconds_bucket{outcome=\"completed\"}[1h])))",
          "editorMode": "code",
          "range": true,
          "format": null,
          "legendFormat": "p50"
        }
      ],
      "description": "Excludes time parked in external KYC and at manual gates: the SLO measures what we control."
    },
    {
      "id": 9,
      "title": "Manual gate wait time p95 (7d)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(pp_workflow_step_duration_seconds_bucket{step=\"compliance-review\"}[7d])))",
          "editorMode": "code",
          "range": true,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 10,
      "title": "KYC outcomes (30d)",
      "type": "piechart",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "pieType": "donut",
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "values": [
            "value",
            "percent"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (outcome) (increase(pp_kyc_decisions_total[30d]))",
          "editorMode": "code",
          "range": true,
          "format": null,
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 11,
      "title": "Certification pass rate by gateway (30d)",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "unit": "percentunit",
          "decimals": 2,
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "green",
                "value": 0.95
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (gateway) (increase(pp_certification_runs_total{outcome=\"passed\"}[30d])) / clamp_min(sum by (gateway) (increase(pp_certification_runs_total[30d])),1e-9)",
          "editorMode": "code",
          "range": true,
          "format": null,
          "legendFormat": "{{gateway}}"
        }
