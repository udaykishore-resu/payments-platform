{
  "uid": "pp-executive",
  "title": "Payments \u2014 Executive / Business KPIs",
  "description": "Audience: leadership, product, and on-call during a customer-visible incident. Panel 15 is the one an executive should learn to read.",
  "tags": [
    "payments",
    "executive",
    "business"
  ],
  "timezone": "utc",
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "graphTooltip": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m",
      "15m",
      "1h"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "AMP",
          "value": "AMP"
        },
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "env",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(pp_http_requests_total, env)",
        "query": {
          "query": "label_values(pp_http_requests_total, env)",
          "refId": "env"
        },
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "sort": 1,
        "current": {
          "selected": false,
          "text": "prod",
          "value": "prod"
        },
        "options": [],
        "hide": 0
      },
      {
        "name": "region",
        "label": "Region",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(pp_http_requests_total, region)",
        "query": {
          "query": "label_values(pp_http_requests_total, region)",
          "refId": "region"
        },
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "sort": 1,
        "current": {
          "selected": false,
          "text": "eu-west-1",
          "value": "eu-west-1"
        },
        "options": [],
        "hide": 0
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(pp_http_requests_total, service)",
        "query": {
          "query": "label_values(pp_http_requests_total, service)",
          "refId": "service"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "sort": 1,
        "current": {
          "selected": false,
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "hide": 0
      },
      {
        "name": "gateway",
        "label": "Gateway",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(pp_gateway_errors_total, gateway)",
        "query": {
          "query": "label_values(pp_gateway_errors_total, gateway)",
          "refId": "gateway"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "sort": 1,
        "current": {
          "selected": false,
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "hide": 0
      },
      {
        "name": "tenant_tier",
        "label": "Tenant tier",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(pp_http_requests_total, tenant_tier)",
        "query": {
          "query": "label_values(pp_http_requests_total, tenant_tier)",
          "refId": "tenant_tier"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "sort": 1,
        "current": {
          "selected": false,
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "hide": 0
      },
      {
        "name": "interval",
        "label": "Interval",
        "type": "interval",
        "query": "1m,5m,10m,30m,1h",
        "auto": true,
        "auto_count": 30,
        "auto_min": "1m",
        "current": {
          "text": "5m",
          "value": "5m"
        },
        "hide": 0,
        "options": [
          {
            "text": "1m",
            "value": "1m",
            "selected": false
          },
          {
            "text": "5m",
            "value": "5m",
            "selected": true
          },
          {
            "text": "10m",
            "value": "10m",
            "selected": false
          },
          {
            "text": "30m",
            "value": "30m",
            "selected": false
          },
          {
            "text": "1h",
            "value": "1h",
            "selected": false
          }
        ]
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Deploys",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "enable": true,
        "iconColor": "purple",
        "expr": "changes(kube_deployment_status_observed_generation[1m]) > 0",
        "titleFormat": "deploy",
        "textFormat": "{{deployment}}",
        "hide": false,
        "description": "Argo CD sync events overlaid on every panel. Half of 'when did this start' questions are answered by the purple line, and asking them without deploy markers is guessing."
      },
      {
        "name": "Rollout steps",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "enable": true,
        "iconColor": "orange",
        "expr": "changes(rollout_info_replicas_updated[1m]) > 0",
        "titleFormat": "canary step",
        "textFormat": "{{name}}"
      }
    ]
  },
  "links": [
    {
      "title": "Runbooks",
      "type": "link",
      "url": "https://docs.example.com/runbooks",
      "targetBlank": true,
      "icon": "doc"
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "Payment volume (TPS)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "unit": "reqps",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(pp_payments_total{outcome=\"created\"}[5m]))",
          "editorMode": "code",
          "range": true,
          "format": "time_series"
        }
      ],
      "description": "Payments created per second. The denominator of almost every other number on this page."
    },
    {
      "id": 2,
      "title": "Authorized value per minute",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "unit": "currencyEUR",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(pp_payment_authorized_amount_minor_total[5m])) * 60 / 100",
          "editorMode": "code",
          "range": true,
          "format": "time_series"
        }
      ],
      "description": "Major units. Per-currency breakdown is panel 3 \u2014 this one sums minor units across currencies and is therefore a trend indicator, not an accounting figure."
    },
    {
      "id": 3,
      "title": "Value by currency",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 8,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "unit": "currencyEUR",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (currency) (rate(pp_payment_authorized_amount_minor_total[1h])) * 3600 / 100",
          "editorMode": "code",
          "range": true,
          "format": null,
          "legendFormat": "{{currency}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Authorization rate",
      "type": "gauge",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 14,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "unit": "percentunit",
          "decimals": 3,
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.9
              },
              {
                "color": "green",
                "value": 0.95
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(pp_payments_total{outcome=\"authorized\"}[30m])) / clamp_min(sum(rate(pp_payments_total{outcome=~\"authorized|declined|failed\"}[30m])),1e-9)",
          "editorMode": "code",
          "range": true,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 5,
      "title": "Error budget remaining",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 19,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "unit": "percentunit",
          "decimals": 2,
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.25
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "pp:error_budget_remaining:payment_api",
          "editorMode": "code",
          "range": true,
          "format": "time_series"
        }
      ],
      "description": "Below 25% is a soft deploy freeze; below 10% is a hard freeze and the reliability backlog becomes the sprint."
    },
    {
      "id": 6,
      "title": "Auth rate vs 7-day baseline",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "unit": "percentunit",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "pp:payment_authorization_rate:ratio_rate30m",
          "editorMode": "code",
          "range": true,
          "format": null,
          "legendFormat": "current \u2014 {{gateway}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "pp:payment_authorization_rate:baseline7d",
          "editorMode": "code",
          "range": true,
          "format": null,
          "legendFormat": "baseline 7d \u2014 {{gateway}}"
        }
      ],
      "description": "The baseline is offset 1h so an in-progress incident cannot drag its own reference line down. A gap of more than 5pp pages."
    },
    {
      "id": 7,
      "title": "Error budget burn-down (30d)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "unit": "percentunit",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.25
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "1 - (pp:payment_api_error:ratio_rate3d / 0.0001)",
          "editorMode": "code",
          "range": true,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 8,
      "title": "Payment mix by method",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 20,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (payment_method) (rate(pp_payments_total{outcome=\"created\"}[5m]))",
          "editorMode": "code",
          "range": true,
          "format": null,
          "legendFormat": "{{payment_method}}"
        }
      ]
    },
    {
      "id": 9,
      "title": "Gateway share of traffic",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 20,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (gateway) (rate(pp_routing_decisions_total[5m]))",
          "editorMode": "code",
          "range": true,
          "format": null,
          "legendFormat": "{{gateway}}"
        }
      ]
    },
    {
      "id": 10,
      "title": "Decline reasons (24h)",
      "type": "piechart",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "pieType": "donut",
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "values": [
            "value",
            "percent"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "topk(8, sum by (reason) (increase(pp_payment_declines_total[24h])))",
          "editorMode": "code",
          "range": true,
          "format": null,
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 11,
      "title": "Availability SLO (30d)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 21
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "unit": "percentunit",
          "decimals": 4,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.9999
              }
